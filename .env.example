# --- LLM (OpenAI uyumlu uç nokta) ---
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.5-flash
# LLM_TIMEOUT_SECONDS=180
# LLM_MAX_RETRIES=3

# --- Sunucu ---
# APP_HOST=127.0.0.1
# APP_PORT=8080
# LOG_LEVEL=INFO
# Arayüz farklı bir alan adından sunulacaksa (JSON liste):
# CORS_ORIGINS=["https://evrak.kurum.gov.tr"]

# --- Girdi ve saklama ---
# MAX_FILE_SIZE_MB=20
# MAX_TEXT_CHARS=100000
# KEEP_UPLOADS=false        # true: yüklenen dosyalar analizden sonra silinmez
# HISTORY_DIR=data/history
# MAX_CONCURRENT_JOBS=2     # Aynı anda çalışan analiz sayısı (LLM kotasını korur)

# --- OCR ---
# TESSERACT_CMD=tesseract
# OCR_LANGUAGE=tur

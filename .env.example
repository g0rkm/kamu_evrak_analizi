# --- LLM (OpenAI uyumlu uç nokta) ---
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.5-flash
# LLM_TIMEOUT_SECONDS=180
# LLM_MAX_RETRIES=3

# --- Sunucu ---
# APP_HOST=127.0.0.1
# APP_PORT=8080
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# Arayüz farklı bir alan adından sunulacaksa (JSON liste):
# CORS_ORIGINS=["https://evrak.kurum.gov.tr"]

# --- Girdi ve saklama ---
# MAX_FILE_SIZE_MB=20
# MAX_TEXT_CHARS=100000
# KEEP_UPLOADS=false        # true: yüklenen dosyalar analizden sonra silinmez
# HISTORY_DIR=data/history
# MAX_CONCURRENT_JOBS=2     # Aynı anda çalışan analiz sayısı (LLM kotasını korur)

# --- OCR ---
# TESSERACT_CMD=tesseract
# OCR_LANGUAGE=tur

# --- Önbellek ---
# LLM_CACHE_TTL_SECONDS=3600  # 0 = önbellek devre dışı

# --- Loglama ---
# LOG_FORMAT=text            # "text" veya "json" (production icin json onerililr)
# LOG_FILE=                  # Boş = sadece console; dosya yolu verilirse log dosyasına da yazar

# --- Pipeline ---
# PIPELINE_TIMEOUT_SECONDS=300  # Pipeline toplam sure siniri (saniye)

# --- Ortam ---
# ENVIRONMENT=development     # "development", "staging", "production"

# --- Güvenlik ---
# RATE_LIMIT_REQUESTS=60     # Dakikada izin verilen maksimum istek
# RATE_LIMIT_WINDOW=60       # Rate limit penceresi (saniye)
# TRUSTED_PROXIES=[]         # Güvenilir proxy IP'leri (JSON liste)
# CSP_REPORT_ONLY=true       # true: CSP ihlalleri sadece raporlanır, engellemez

# Admin token (hassas endpoint'ler için)
# ADMIN_TOKEN=

# --- Performans ---
# LLM_TOKEN_BUDGET=0         # 0 = sınırsız; >0 = toplam token üst limiti

# Bakım modu (true/false)
# MAINTENANCE_MODE=false

# Maksimum geçmiş kayıt sayısı
# MAX_HISTORY_RECORDS=10000

# Disk uyarı eşiği (MB)
# DISK_WARNING_THRESHOLD_MB=100
